				"type": "String"
			},
			{
				"name": "BranchID",
				"type": "String"
			},
			{
				"name": "AccountType",
				"type": "String"
			},
			{
				"name": "CurrencyCode",
				"type": "String"
			},
			{
				"name": "OpeningDate",
				"type": "String"
			},
			{
				"name": "ClosingDate",
				"type": "String"
			},
			{
				"name": "CurrentBalance",
				"type": "String"
			},
			{
				"name": "AvailableBalance",
				"type": "String"
			},
			{
				"name": "AccountStatus",
				"type": "String"
			},
			{
				"name": "CreatedDate",
				"type": "String"
			},
			{
				"name": "LastModifiedDate",
				"type": "String"
			}
		]
	}
