{
	"name": "PL_SQL_To_ADLS_Raw",
	"properties": {
		"activities": [
			{
				"name": "LKP_SQL_Control",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "SELECT *\nFROM dbo.ADF_Control_Table\nWHERE SourceSystem = 'SQLServer'\n  AND IsActive = 1\nORDER BY LoadSequence;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "FE_SQL_Tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "LKP_SQL_Control",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_SQL_Control').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "IF_LoadType",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(item().LoadType,'INCREMENTAL')",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "CP_FULL_SQL_To_ADLS",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "SqlServerSource",
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"sink": {
												"type": "DelimitedTextSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "DelimitedTextWriteSettings",
													"quoteAllText": true,
													"fileExtension": ".txt"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "DS_SQL_Source",
												"type": "DatasetReference",
												"parameters": {
													"p_schemaName": {
														"value": "@item().SourceSchema",
														"type": "Expression"
													},
													"p_tableName": "@item().SourceObject"
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_ADLS_Raw",
												"type": "DatasetReference",
												"parameters": {
													"p_folderPath": "@concat(     item().TargetFolder,     '/year=',     formatDateTime(variables('v_RunTimestamp'),'yyyy'),     '/month=',     formatDateTime(variables('v_RunTimestamp'),'MM'),     '/day=',     formatDateTime(variables('v_RunTimestamp'),'dd') )",
													"p_fileName": "@concat(     toLower(item().SourceName),     '_',     formatDateTime(         variables('v_RunTimestamp'),         'yyyyMMdd_HHmmss'     ),     '.csv' )"
												}
											}
										]
									}
								],
								"ifTrueActivities": [
									{
										"name": "CP_INCREMENTAL_SQL_To_ADLS",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "SqlServerSource",
												"sqlReaderQuery": "@concat(\n    'SELECT * FROM ',\n    item().SourceSchema,\n    '.',\n    item().SourceObject,\n    ' WHERE ',\n    item().WatermarkColumn,\n    ' > ''',\n    formatDateTime(\n        item().LastWatermarkValue,\n        'yyyy-MM-dd HH:mm:ss.fffffff'\n    ),\n    ''''\n)",
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"sink": {
												"type": "DelimitedTextSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "DelimitedTextWriteSettings",
													"quoteAllText": true,
													"fileExtension": ".txt"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "DS_SQL_Source",
												"type": "DatasetReference",
												"parameters": {
													"p_schemaName": "@item().SourceSchema",
													"p_tableName": "@item().SourceObject"
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_ADLS_Raw",
												"type": "DatasetReference",
												"parameters": {
													"p_folderPath": "@concat(     'SELECT * FROM ',     item().SourceSchema,     '.',     item().SourceObject,     ' WHERE ',     item().WatermarkColumn,     ' > ''',     formatDateTime(         item().LastWatermarkValue,         'yyyy-MM-dd HH:mm:ss.fffffff'     ),     '''' )",
													"p_fileName": "@concat(     toLower(item().SourceName),     '_',     formatDateTime(         variables('v_RunTimestamp'),         'yyyyMMdd_HHmmss'     ),     '.csv' )"
												}
											}
										]
									},
									{
										"name": "LKP_NewWatermark",
										"type": "Lookup",
										"dependsOn": [
											{
												"activity": "CP_INCREMENTAL_SQL_To_ADLS",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "SqlServerSource",
												"sqlReaderQuery": "@concat(\n    'SELECT MAX(',\n    item().WatermarkColumn,\n    ') AS NewWatermark FROM ',\n    item().SourceSchema,\n    '.',\n    item().SourceObject\n)",
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"dataset": {
												"referenceName": "DS_SQL_Source",
												"type": "DatasetReference",
												"parameters": {
													"p_schemaName": "@item().SourceSchema",
													"p_tableName": "@item().SourceObject"
												}
											}
										}
									},
									{
										"name": "SP_Update_Watermark",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "LKP_NewWatermark",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo].[usp_Update_ADF_Watermark]",
											"storedProcedureParameters": {
												"ControlID": {
													"value": "@item().ControlID",
													"type": "Int32"
												},
												"NewWatermark": {
													"value": "@activity('LKP_NewWatermark').output.firstRow.NewWatermark",
													"type": "String"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "LS_SQLServer_ApexCoreBanking_DEV",
											"type": "LinkedServiceReference"
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"annotations": []
	}
}