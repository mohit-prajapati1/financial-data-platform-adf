{
	"name": "PL_SQL_To_ADLS_Raw",
	"properties": {
		"activities": [
			{
				"name": "LKP_SQL_Control",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "SELECT *\nFROM dbo.ADF_Control_Table\nWHERE SourceSystem = 'SQLServer'\n  AND IsActive = 1\nORDER BY LoadSequence;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_Control",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "FE_SQL_Tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "LKP_SQL_Control",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_SQL_Control').output.value",
						"type": "Expression"
					},
					"batchCount": 5,
					"activities": [
						{
							"name": "CP_SQL_To_ADLS_Raw",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_SQL_Source",
									"type": "DatasetReference",
									"parameters": {
										"p_schemaName": {
											"value": "@item().SourceSchema",
											"type": "Expression"
										},
										"p_tableName": {
											"value": "@item().SourceObject",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADLS_Raw",
									"type": "DatasetReference",
									"parameters": {
										"p_folderPath": {
											"value": "@concat(\n    item().TargetFolder,\n    '/year=',\n    formatDateTime(\n        convertFromUtc(\n            utcNow(),\n            'India Standard Time'\n        ),\n        'yyyy'\n    ),\n    '/month=',\n    formatDateTime(\n        convertFromUtc(\n            utcNow(),\n            'India Standard Time'\n        ),\n        'MM'\n    ),\n    '/day=',\n    formatDateTime(\n        convertFromUtc(\n            utcNow(),\n            'India Standard Time'\n        ),\n        'dd'\n    )\n)",
											"type": "Expression"
										},
										"p_fileName": "@concat(     toLower(item().SourceName),     '_',     formatDateTime(         convertFromUtc(             utcNow(),             'India Standard Time'         ),         'yyyyMMdd_HHmmss'     ),     '.csv' )"
									}
								}
							]
						}
					]
				}
			}
		],
		"annotations": []
	}
}